{
  "expo": {
    "name": "YumQuick",
    "slug": "yumquick",
    "scheme": "yumquick",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-new.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon-new.png",
      "resizeMode": "cover",
      "backgroundColor": "#F5CB58"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-new.png",
        "backgroundColor": "#F5CB58"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.YumQuick"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5CB58",
          "image": "./assets/splash-icon-new.png",
          "imageWidth": 200,
          "resizeMode": "cover"
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3ba35948-f490-43f7-82e5-cb2732f20e4a"
      }
    },
    "owner": "victory94"
  }
}
